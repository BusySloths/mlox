---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import NewsBanner from '../components/NewsBanner.astro';
import TuiGallery from '../components/TuiGallery.astro';
import { getCollection } from 'astro:content';

const pages = await getCollection('pages');
const page = (id: string) => pages.find((p) => p.id === id);
const hero = page('hero.md');
const gallery = page('gallery.md');
const features = page('features.md');
const how = page('how-it-works.md');
const why = page('why-mlox.md');
const start = page('getting-started.md');
const heroContent = hero ? await hero.render() : null;

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const accent: Record<string, string> = { lime: 'var(--lime)', amber: 'var(--amber)', rose: 'var(--rose)' };
const services = features?.data.services ?? [];
---

<BaseLayout
  title="MLOX: your ML stack on your own servers, slothfully simple"
  description={hero?.data.description}
>
  <NewsBanner />
  <Header />

  <main id="main">
    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="wrap hero__grid">
        <div class="hero__copy">
          {hero?.data.eyebrow && <p class="eyebrow rise rise-1">{hero.data.eyebrow}</p>}
          <h1 class="h-display rise rise-2">
            {hero?.data.title}
            <span class="hero__sub serif">{hero?.data.subtitle}</span>
          </h1>
          <p class="lede rise rise-3">{hero?.data.description}</p>

          {hero?.data.install && (
            <div class="install rise rise-4">
              <span class="install__prompt mono" aria-hidden="true">$</span>
              <code class="install__cmd" id="install-cmd">{hero.data.install}</code>
              <button class="install__copy" data-copy="#install-cmd" aria-label="Copy install command">
                <span data-label>Copy</span>
              </button>
            </div>
          )}

          <div class="hero__ctas rise rise-5">
            <a class="btn" href={hero?.data.cta_primary_link}>{hero?.data.cta_primary} <span aria-hidden="true">→</span></a>
            <a class="btn btn--ghost" href={hero?.data.cta_secondary_link} target="_blank" rel="noopener noreferrer">
              <span aria-hidden="true">★</span> {hero?.data.cta_secondary}
            </a>
          </div>
        </div>

        <div class="hero__stage rise rise-3">
          <picture class="hero__sloth" aria-hidden="true">
            <source srcset={`${base}mlox_sloth_branch.webp`} type="image/webp" />
            <img src={`${base}mlox_sloth_branch.png`} alt="" width="766" height="380" />
          </picture>
          <div class="term">
            <div class="term__chrome" aria-hidden="true">
              <span class="dot"></span><span class="dot"></span><span class="dot"></span>
              <span class="term__title mono">mlox tui</span>
              <span class="term__live mono"><i></i> live tour</span>
            </div>
            <video
              class="term__video"
              src={`${base}mlox_tui_tour.mp4`}
              poster={`${base}mlox_tui_tour_poster.webp`}
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              width="1600"
              height="968"
              aria-label="A 40-second tour of the MLOX terminal UI: logging in, the infrastructure overview, knowledge board, firewall, repositories, workflows, models, databases and live monitoring."
              data-hero-video
            ></video>
          </div>
          <p class="hero__note mono">real project · real servers · private details blurred</p>
        </div>
      </div>
    </section>

    <!-- ============ STATS ============ -->
    {hero?.data.stats && (
      <section class="stats" aria-label="MLOX at a glance">
        <div class="wrap stats__grid">
          {hero.data.stats.map((s) => (
            <div class="stat reveal">
              <span class="stat__value">{s.value}</span>
              <span class="stat__label">{s.label}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- ============ MARQUEE ============ -->
    {services.length > 0 && (
      <section class="marquee" aria-label="Services you can deploy">
        <p class="marquee__label mono">in the catalog, moving at sloth speed:</p>
        <div class="marquee__track">
          <ul class="marquee__row">
            {[...services, ...services].map((name, i) => (
              <li aria-hidden={i >= services.length ? 'true' : undefined}>{name}</li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <!-- ============ TOUR ============ -->
    {gallery?.data.shots && (
      <section id="tour" class="section">
        <div class="wrap">
          <div class="section__head reveal">
            <p class="eyebrow">{gallery.data.eyebrow}</p>
            <h2 class="h-section">{gallery.data.title} <span class="serif accent">without installing it.</span></h2>
            <p class="lede">{gallery.data.description}</p>
          </div>
          <div class="reveal">
            <TuiGallery shots={gallery.data.shots} />
          </div>
        </div>
      </section>
    )}

    <!-- ============ FEATURES ============ -->
    {features?.data.features && (
      <section id="features" class="section">
        <div class="wrap">
          <div class="section__head reveal">
            <p class="eyebrow">{features.data.eyebrow}</p>
            <h2 class="h-section">{features.data.title}</h2>
          </div>
          <div class="features">
            {features.data.features.map((f, i) => (
              <article class="panel feature reveal" style={`--accent:${accent[f.color] ?? 'var(--lime)'}; transition-delay:${i * 90}ms`}>
                <span class="panel__title">{f.icon} {f.title}</span>
                {f.description && <p class="feature__desc">{f.description}</p>}
                <ul>
                  {f.items.map((item) => <li>{item}</li>)}
                </ul>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ============ HOW IT WORKS ============ -->
    {how?.data.steps && (
      <section id="how" class="section">
        <div class="wrap">
          <div class="section__head reveal">
            <p class="eyebrow">{how.data.eyebrow}</p>
            <h2 class="h-section">{how.data.title}</h2>
            <p class="lede">{how.data.description}</p>
          </div>
          <ol class="how">
            {how.data.steps.map((step, i) => (
              <li class="how__step reveal">
                <div class="how__text">
                  <span class="how__num mono">0{i + 1}</span>
                  <h3>{step.title}</h3>
                  <p>{step.description}</p>
                </div>
                {step.image && (
                  <div class="how__shot">
                    <picture>
                      <source srcset={`${base}${step.image}.webp`} type="image/webp" />
                      <img src={`${base}${step.image}.png`} alt={step.alt ?? ''} width="1920" height="1163" loading="lazy" decoding="async" />
                    </picture>
                  </div>
                )}
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    <!-- ============ CLI ============ -->
    <section class="section cli-band">
      <div class="wrap cli">
        <div class="cli__copy reveal">
          <p class="eyebrow">Automate it</p>
          <h2 class="h-section">The TUI for exploring. <span class="serif accent">The CLI for everything else.</span></h2>
          <p class="lede">
            Every project is just as reachable from scripts, CI pipelines and coding agents. Human-friendly
            tables by default, machine-readable JSON with one flag, and the same Python API underneath.
          </p>
          <pre class="snippet"><code><span class="c"># what is running, as JSON</span>
<span class="p">$</span> mlox --output json service list

<span class="c"># deploy from the catalog, then check logs</span>
<span class="p">$</span> mlox service add --help
<span class="p">$</span> mlox service logs mlflow</code></pre>
        </div>
        <div class="cli__shot reveal">
          <picture>
            <source srcset={`${base}mlox_tui_cli.webp`} type="image/webp" />
            <img src={`${base}mlox_tui_cli.png`} alt="The MLOX command line showing mlox --help and a table from mlox server list." width="1600" height="1387" loading="lazy" decoding="async" />
          </picture>
        </div>
      </div>
    </section>

    <!-- ============ WHY ============ -->
    {why?.data.cards && (
      <section id="why" class="section">
        <div class="wrap">
          <div class="section__head reveal">
            <p class="eyebrow">{why.data.eyebrow}</p>
            <h2 class="h-section">{why.data.title}</h2>
            {heroContent && <div class="lede why__intro"><heroContent.Content /></div>}
          </div>
          <div class="why">
            {why.data.cards.map((card, i) => (
              <article class="why__card reveal" style={`transition-delay:${i * 80}ms`}>
                <span class="why__icon mono">{card.icon}</span>
                <h3>{card.title}</h3>
                <p>{card.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ============ GET STARTED ============ -->
    {start?.data.steps && (
      <section id="get-started" class="section start">
        <div class="wrap">
          <div class="section__head section__head--center reveal">
            <p class="eyebrow">{start.data.eyebrow}</p>
            <h2 class="h-section">{start.data.title}</h2>
            <p class="serif start__sub">{start.data.subtitle}</p>
            <p class="lede">{start.data.description}</p>
          </div>
          <ol class="steps">
            {start.data.steps.map((step, i) => (
              <li class="panel step reveal" style={`transition-delay:${i * 80}ms`}>
                <span class="panel__title">step {i + 1}</span>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
                {step.code && (
                  <div class="step__code">
                    <code id={`step-code-${i}`}>{step.code}</code>
                    <button class="step__copy" data-copy={`#step-code-${i}`} aria-label={`Copy: ${step.code}`}><span data-label>Copy</span></button>
                  </div>
                )}
                {step.note && <p class="step__note" set:html={step.note} />}
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    <!-- ============ SPONSORS ============ -->
    <section id="sponsors" class="section sponsors">
      <div class="wrap">
        <p class="eyebrow">Supported by</p>
        <div class="sponsors__row">
          <img src={`${base}BMFTR_logo.jpg`} alt="Funded by the German Federal Ministry of Research, Technology and Space (BMFTR)" loading="lazy" />
          <img src={`${base}PrototypeFund_logo_dark.png`} alt="Prototype Fund" loading="lazy" class="sponsors__pf" />
        </div>
      </div>
    </section>
  </main>

  <!-- ============ FOOTER ============ -->
  <footer class="footer">
    <div class="wrap footer__grid">
      <div class="footer__brand">
        <picture aria-hidden="true">
          <source srcset={`${base}mlox_sloth_branch.webp`} type="image/webp" />
          <img src={`${base}mlox_sloth_branch.png`} alt="" width="220" height="109" loading="lazy" />
        </picture>
        <p class="footer__tag"><span class="mono">MLOX</span>, MLOps-in-a-Box. <span class="serif">Slothfully simple.</span></p>
        <p class="footer__small">Open source under the MIT license.</p>
      </div>
      <nav aria-label="Resources">
        <h4>Resources</h4>
        <ul>
          <li><a href="https://github.com/BusySloths/mlox" target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li><a href={`${base}docs/`} target="_blank" rel="noopener noreferrer">API documentation</a></li>
          <li><a href="https://github.com/BusySloths/mlox/blob/main/docs/INSTALLATION.md" target="_blank" rel="noopener noreferrer">Installation guide</a></li>
          <li><a href="https://github.com/BusySloths/mlox/issues" target="_blank" rel="noopener noreferrer">Issues</a></li>
          <li><a href="https://github.com/BusySloths/mlox/discussions" target="_blank" rel="noopener noreferrer">Discussions</a></li>
        </ul>
      </nav>
      <nav aria-label="Community">
        <h4>Community</h4>
        <ul>
          <li><a href="https://github.com/BusySloths/mlox/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener noreferrer">Contributing</a></li>
          <li><a href="https://github.com/BusySloths/mlox/blob/main/CODE_OF_CONDUCT.md" target="_blank" rel="noopener noreferrer">Code of conduct</a></li>
          <li><a href="https://github.com/BusySloths/mlox/blob/main/docs/DOCTRINE.md" target="_blank" rel="noopener noreferrer">Doctrine</a></li>
        </ul>
      </nav>
      <div>
        <h4>Contact</h4>
        <ul>
          <li><a href="mailto:contact@mlox.org">contact@mlox.org</a></li>
          <li><a href="https://mastodon.social/@drbusysloth" target="_blank" rel="noopener noreferrer">@drbusysloth on Mastodon</a></li>
        </ul>
      </div>
    </div>
    <div class="wrap footer__bottom mono">
      <span>© 2026 BusySloths</span>
      <a href="#top">back to the canopy ↑</a>
    </div>
  </footer>
</BaseLayout>

<style>
  /* ---------- hero ---------- */
  .hero { padding: clamp(48px, 8vw, 110px) 0 40px; }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .hero__copy { display: grid; grid-template-columns: minmax(0, 1fr); gap: 26px; min-width: 0; }
  .hero__sub {
    display: block;
    margin-top: 0.12em;
    font-size: 0.78em;
    color: var(--lime);
  }
  .install {
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: min(520px, 100%);
    min-width: 0;
    padding: 8px 8px 8px 18px;
    border-radius: 14px;
    border: 1px solid var(--line-strong);
    background: rgba(7, 17, 12, 0.7);
  }
  .install__prompt { color: var(--lime); }
  .install__cmd {
    flex: 1;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 14.5px;
    color: var(--cream);
    white-space: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .install__copy, .step__copy {
    flex: none;
    padding: 9px 14px;
    border-radius: 10px;
    border: 1px solid var(--line-strong);
    background: rgba(197, 240, 106, 0.08);
    color: var(--lime);
    font-family: var(--font-mono);
    font-size: 12.5px;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .install__copy:hover, .step__copy:hover { background: var(--lime); color: var(--bg-deep); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; }

  .hero__stage { position: relative; padding-top: 70px; }
  .hero__sloth {
    position: absolute;
    top: 0;
    right: 9%;
    width: clamp(150px, 19vw, 250px);
    z-index: 3;
    transform-origin: 18% 12%;
    animation: sway 7s ease-in-out infinite;
    filter: drop-shadow(0 12px 20px rgba(0, 0, 0, 0.55));
  }
  .term {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(197, 240, 106, 0.3);
    background: #0d1d15;
    transform: perspective(1600px) rotateY(-7deg) rotateX(2.5deg);
    transform-origin: left center;
    box-shadow: -30px 50px 110px -30px rgba(0, 0, 0, 0.9), 0 0 90px -30px rgba(197, 240, 106, 0.35);
    transition: transform 0.8s var(--ease);
  }
  .hero__stage:hover .term { transform: perspective(1600px) rotateY(-2deg) rotateX(1deg); }
  .term__chrome {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 14px;
    background: #141c18;
  }
  .dot { width: 11px; height: 11px; border-radius: 50%; background: #3a423d; }
  .term__title { margin: 0 auto; font-size: 12px; color: #7c867f; }
  .term__live { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; color: var(--rose); }
  .term__live i { width: 7px; height: 7px; border-radius: 50%; background: var(--rose); animation: blink 1.6s steps(1) infinite; }
  .term__video { width: 100%; height: auto; aspect-ratio: 1600 / 968; background: #0d1d15; }
  .hero__note { margin: 16px 0 0; font-size: 12px; color: #6f8170; text-align: right; }

  /* ---------- stats ---------- */
  .stats { padding: 36px 0 12px; }
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .stat { display: grid; gap: 6px; padding: 28px 22px; border-left: 1px solid var(--line); }
  .stat:first-child { border-left: 0; padding-left: 0; }
  .stat__value {
    font-family: var(--font-mono);
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 500;
    line-height: 1;
    color: var(--amber);
    letter-spacing: -0.04em;
  }
  .stat__label { color: var(--muted); font-size: 15px; max-width: 22ch; }

  /* ---------- marquee ---------- */
  .marquee { padding: 46px 0 30px; overflow: hidden; }
  .marquee__label { text-align: center; color: #6f8170; font-size: 12.5px; margin: 0 0 18px; }
  .marquee__track {
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .marquee__row {
    display: flex;
    gap: 14px;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: drift 90s linear infinite;
  }
  .marquee:hover .marquee__row { animation-play-state: paused; }
  .marquee__row li {
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(16, 36, 26, 0.6);
    color: var(--cream);
    font-size: 15.5px;
    white-space: nowrap;
  }
  .marquee__row li:nth-child(3n) { border-color: rgba(242, 181, 65, 0.35); }
  .marquee__row li:nth-child(4n) { border-color: rgba(197, 240, 106, 0.35); }
  @media (prefers-reduced-motion: reduce) {
    .marquee__row { animation: none; flex-wrap: wrap; justify-content: center; width: auto; padding: 0 20px; }
    .marquee__row li[aria-hidden="true"] { display: none; }
  }

  /* ---------- sections ---------- */
  .section { padding: clamp(70px, 10vw, 130px) 0 0; }
  .section__head { display: grid; gap: 18px; margin-bottom: 46px; max-width: 980px; }
  .section__head--center { margin-inline: auto; text-align: center; justify-items: center; }
  .accent { color: var(--lime); }

  /* ---------- features ---------- */
  .features { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 26px; }
  .feature { --accent: var(--lime); }
  .feature .panel__title { color: var(--accent); }
  .feature { border-color: color-mix(in srgb, var(--accent) 40%, transparent); }
  .feature__desc { margin: 0 0 18px; color: var(--cream); font-size: 18px; line-height: 1.45; }
  .feature ul { display: grid; gap: 12px; margin: 0; padding: 18px 0 0; list-style: none; border-top: 1px dashed var(--line); }
  .feature li { position: relative; padding-left: 22px; color: var(--muted); }
  .feature li::before { content: "›"; position: absolute; left: 4px; color: var(--accent); font-family: var(--font-mono); }

  /* ---------- how ---------- */
  .how { display: grid; gap: clamp(60px, 8vw, 110px); margin: 0; padding: 0; list-style: none; }
  .how__step {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(28px, 5vw, 70px);
    align-items: center;
  }
  .how__step:nth-child(even) { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); }
  .how__step:nth-child(even) .how__text { order: 2; }
  .how__num { font-size: 14px; color: var(--amber); }
  .how__text h3 { margin: 10px 0 14px; font-size: clamp(28px, 3vw, 40px); letter-spacing: -0.025em; line-height: 1.05; color: var(--cream); font-weight: 700; }
  .how__text p { margin: 0; color: var(--muted); font-size: 18px; }
  .how__shot {
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    box-shadow: 0 40px 90px -40px rgba(0, 0, 0, 0.9);
    transform: rotate(-0.6deg);
    transition: transform 0.6s var(--ease);
  }
  .how__step:nth-child(even) .how__shot { transform: rotate(0.6deg); }
  .how__shot:hover { transform: none !important; }

  /* ---------- cli ---------- */
  .cli { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(30px, 5vw, 70px); align-items: center; }
  .cli__copy { display: grid; gap: 20px; }
  .snippet {
    margin: 8px 0 0;
    padding: 20px 22px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: rgba(7, 17, 12, 0.75);
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.75;
    color: var(--cream);
    overflow-x: auto;
  }
  .snippet .c { color: #6f8170; }
  .snippet .p { color: var(--lime); }
  .cli__shot {
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(243, 233, 210, 0.16);
    box-shadow: 0 40px 100px -40px rgba(0, 0, 0, 0.9);
  }

  /* ---------- why ---------- */
  .why__intro :global(p) { margin: 0 0 12px; }
  .why { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
  .why__card {
    padding: 26px 22px;
    border-radius: var(--radius);
    background: rgba(16, 36, 26, 0.55);
    border: 1px solid var(--line);
    transition: border-color 0.3s, transform 0.4s var(--ease);
  }
  .why__card:hover { border-color: var(--line-strong); transform: translateY(-4px); }
  .why__icon {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 8px;
    background: rgba(242, 181, 65, 0.12);
    color: var(--amber);
    font-size: 14px;
  }
  .why__card h3 { margin: 18px 0 10px; color: var(--cream); font-size: 21px; letter-spacing: -0.015em; line-height: 1.15; }
  .why__card p { margin: 0; color: var(--muted); font-size: 15.5px; }

  /* ---------- get started ---------- */
  .start__sub { margin: -4px 0 0; font-size: clamp(24px, 2.6vw, 32px); color: var(--amber); }
  .steps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px 24px; margin: 0; padding: 0; list-style: none; }
  .step h3 { margin: 0 0 8px; color: var(--cream); font-size: 22px; letter-spacing: -0.015em; }
  .step p { margin: 0; color: var(--muted); }
  .step__code {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
